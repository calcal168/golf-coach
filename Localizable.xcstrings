    "Remove the %@ payment of %@? Any lesson charges recorded against this payment will also be removed." : {
      "comment" : "A confirmation message for reversing a payment for a specific package.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove the %1$@ payment of %2$@? Any lesson charges recorded against this payment will also be removed."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 결제 %@을(를) 삭제하시겠습니까? 이 결제에 기록된 모든 레슨 비용도 삭제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 %@ 付款 %@ 吗？针对此付款记录的所有课程费用也会被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 %@ 付款 %@ 嗎？針對此付款記錄的所有課程費用也會被移除。"
          }
        }
      }
    },
    "Remove the lesson charge of %@ from %@? The credit will be restored." : {
      "comment" : "A confirmation alert for reversing a lesson charge.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove the lesson charge of %1$@ from %2$@? The credit will be restored."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 레슨 비용 %@을(를) 삭제하시겠습니까? 크레딧이 복원됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 %@ 的课程费用 %@ 吗？额度将恢复。"
          }
